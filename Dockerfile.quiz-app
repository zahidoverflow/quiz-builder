# Dockerfile for Quiz Builder OCR AI Application
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY quiz-builder-ocr-ai/package*.json ./

# Install dependencies
RUN npm install

# Copy application files
COPY quiz-builder-ocr-ai/ ./

# Expose port
EXPOSE 5173

# Start the development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
